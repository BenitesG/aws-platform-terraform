# Plugins and modules directory downloaded by terraform init
.terraform/

# The .terraform.lock.hcl does NOT belong here: it MUST be versioned.
# It has nothing sensitive - only the provider name, the installed version,
# the constraint declared in the code and checksums. And it is what guarantees
# everyone uses the same version: provider.tf declares "~> 5.0", which accepts
# any 5.x, so without the lock each machine may install a different version.
# The checksums also make init fail if the package in the registry is altered.
#
# The hashes are PER PLATFORM. Before the CI pipeline exists, generate both:
#   terraform providers lock -platform=windows_amd64 -platform=linux_amd64

# State: NEVER version. It lives in the S3 bucket.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Manual state backups (terraform state pull before a state mv). They carry
# infrastructure IDs. The whole directory stays out of git — the *.tfstate*
# rule already covers the names, this is belt and suspenders.
_state-backups/
_state-mv-work/

# Variables (*.tfvars): THESE ARE versioned. Each directory is a Terraform
# project and its tfvars is its configuration — kept so we can see exactly how
# each resource was created. Secrets do NOT go in tfvars: they live in SSM
# Parameter Store / Secrets Manager. (This sanitized repo carries example
# values only; see the note at the end of the README.)
*.tfvars.json

# Plan output saved to a file
*.tfplan

# Terraform crash logs
crash.log
crash.*.log

# EC2 key pairs / Windows passwords under instances/<stack>/keys/: NEVER
# version. The whole directory is ignored, so no nested .gitignore can
# re-include files from it (e.g. !keys/*.pub).
instances/*/keys/

# Python (tooling under tools/)
__pycache__/
*.pyc

# Flow log evidence under tools/flowlog/ contains real IPs: never version it.
# The exception is the synthetic sample CSV, which stays in the repository.
evidence-*.csv
!example-evidence.csv
