# ---------------------------------------------------------------------------
# images/terraform.tfvars.example
#
# Copie para terraform.tfvars e preencha. O arquivo real esta no .gitignore.
#
# Os valores reais (IDs de subnet, ARN da boundary, etc.) estao em
# CONTEXTO-EXECUCAO-MB-swe-prod.md, na tabela "Dados da conta e IDs criados".
# ---------------------------------------------------------------------------

# DelegatedAdministrator, nao PowerUserAccess: este diretorio cria papel e
# instance profile, e o PowerUser nao tem iam:GetRole nem GetInstanceProfile.
# Sem essas LEITURAS o apply falha depois de criar, deixando objeto orfao.
aws_profile = "acme-swe-prod-admin"

region = "us-west-2"

# SOMENTE LTS. As intermediarias tem 9 meses de suporte.
ubuntu_version = "26.04"

# amd64 (t3, t3a, m5...) ou arm64 (t4g). A arquitetura e assada na AMI:
# imagem amd64 nao roda em t4g e arm64 nao roda em t3a.
architecture        = "amd64"
build_instance_type = "t3a.small"

vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

# PRIVADA. A instancia de build precisa de saida pelo NAT; as subnets publicas
# nao tem rota para fora.
build_subnet_id = "subnet-xxxxxxxxxxxxxxxxx"

# ARN da DelegatedAdminBoundary. Todo papel criado por delegacao precisa
# carrega-la, senao o CreateRole e negado.
permissions_boundary_arn = "arn:aws:iam::ACCOUNT_ID:policy/DelegatedAdminBoundary"

root_volume_size = 20

# Norma ticketing-system standard. Chave com dois-pontos PRECISA de aspas em HCL.
# Obrigatorias: Name, Owner, Department, Environment, DataClassification,
# Project, Application.
common_tags = {
  ManagedBy = "terraform"

  "acme:cost-allocation:Project"     = ""
  "acme:cost-allocation:Application" = "golden-image"
  "acme:cost-allocation:Department"  = ""
  "acme:cost-allocation:CostCenter"  = ""
  "mb:automation:Environment"      = "prod"
  "mb:data:DataClassification"     = "interno"

  Owner      = ""
  ChargeType = ""
}
