# ---------------------------------------------------------------------------
# instances/terraform.tfvars.example
#
# Copy to terraform.tfvars and fill in. The real file is in .gitignore - not
# versioning it is not just secret hygiene: it is not publishing a third party
# team's infrastructure data (IPs, resource IDs from another account).
#
# This .example file DOES go to git: use placeholders only, never a real value.
# ---------------------------------------------------------------------------

# AWS CLI profile (SSO).
#
# Is PowerUserAccess ENOUGH for the apply in this directory? NOT necessarily:
# attaching an instance profile to an instance requires iam:PassRole, which
# PowerUserAccess does not have. Use the profile with DelegatedAdministrator
# (e.g. acme-swe-prod-admin). The S3 backend can still use PowerUser via the
# AWS_PROFILE variable.
aws_profile = "acme-swe-prod-admin"

# Region. Default us-west-2 in variables.tf; declare it here if you want to pin it.
region = "us-west-2"

# VPC where each instance's security group is created.
vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

# PRIVATE-D (acme-swe-prod-private-d). The public subnets use rt-main, which has
# only the "local" route: an instance there has NO EGRESS and the SSM agent does
# not register - the instance is born unreachable, because there is no key pair
# and no port 22. An instance does NOT change subnet: getting it wrong means
# recreating.
private_subnet_id = "subnet-xxxxxxxxxxxxxxxxx"

# acme-swe-prod-baseline-sg: empty ingress, egress TCP 443 and 80.
# NO LONGER used by the instances (each machine has its own SG since 10/16),
# kept as a reference in case it needs to be passed in extra_security_group_ids.
baseline_security_group_id = "sg-xxxxxxxxxxxxxxxxx"

# Name of the baseline role's instance profile:
# AmazonSSMManagedInstanceCore + CloudWatchAgentServerPolicy.
# Generic name on purpose - it is a baseline role, not an environment one.
# WITHOUT IT the instance is born unreachable (the SSM agent does not register).
instance_profile = "delegated-ec2-ssm"

# ARM64 golden image AMI (t4g instances). Empty = the arm module stays commented
# out. Changing the image of an existing instance is an explicit act
# (terraform apply -replace=...), never a side effect of editing this variable -
# the module has lifecycle { ignore_changes = [ami] }.
arm_ami_id = "ami-0xxxxxxxxxxxxxxxx"

# arm64 CONTAINER HOST lineage AMI (Docker with log rotation). DIFFERS from
# arm_ami_id, which is the base without Docker. Use on a machine that runs
# containers.
arm_docker_ami_id = "ami-0xxxxxxxxxxxxxxxx"

# x86_64 BASE lineage AMI (t3a/t3/m5 instances). Empty = you can only create
# Graviton. WATCH OUT: the minimum disk size of the x86 lineages is 20 GB, not
# 30 like the arm64 ones, and an x86 AMI does NOT run on t4g/m6g/c7g. Same
# recreation guard as arm_ami_id: lifecycle { ignore_changes = [ami] } in the
# module.
x86_ami_id = ""

# x86_64 CONTAINER HOST lineage AMI (Docker with log rotation). DIFFERS from
# x86_ami_id, which is the base without Docker. Minimum disk size 20 GB; types
# t3a/t3/m5.
x86_docker_ami_id = ""

# Legacy ERP host in the production account, as a /32. Destination and source of
# the legacy ERP integration rules.
#
# Do NOT put the real address here: this value goes into the tfvars (gitignored)
# and the .example is public. /32 REQUIRED (the validation rejects a range) - a
# wider range would give the entire remote VPC the integration ports, including
# INBOUND 65022.
erp_host_cidr = "0.0.0.0/32"

# Industrial engineering workstation host as a /32, source and destination of
# the PROTOSIM industrial protocol rules.
#
# WATCH OUT - this machine is NOT in this account: the address belongs to
# 172.31.0.0/16 (the production account's VPC), reached through the peering.
# Same reason as erp_host_cidr for being a variable. /32 REQUIRED. Empty = the
# PROTOSIM rules do not come up.
plc_workstation_host_cidr = "0.0.0.0/32"

# Internal tagging standard tags. A key with a colon REQUIRES quotes in HCL
# (the parser fails at init without them).
#
# The provider's default_tags covers what is common to the directory; Project,
# Application and Environment are a per-machine question and go in each module's
# block in main.tf.
common_tags = {
  ManagedBy = "terraform"

  "acme:cost-allocation:Project"     = "best-practices"
  "acme:cost-allocation:Application" = "baseline"
  "acme:cost-allocation:Department"  = "swe"
  "acme:cost-allocation:CostCenter"  = "cc-infra-1000"
  "acme:automation:Environment"      = "prod"
  "acme:data:DataClassification"     = "internal"

  Owner      = "plataforma@example.com"
  ChargeType = "dedicated"
}
